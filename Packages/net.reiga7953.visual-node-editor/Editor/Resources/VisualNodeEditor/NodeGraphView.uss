/*
 * Attached to NodeGraphView itself. GraphView attaches its built-in GraphView.uss to itself too,
 * and for equal specificity the sheet closest to the element wins, so grid styles placed on the
 * window root were silently overridden.
 */

GridBackground {
  --grid-background-color: #1e1e1e;
  --line-color: rgba(255, 255, 255, 0.07);
  --thick-line-color: rgba(255, 255, 255, 0.15);
  --spacing: 20;
  --thick-lines: 10;
}

/* MiniMap: anchored to the bottom-right corner of the graph */
#vne-minimap {
  position: absolute;
  right: 10px;
  bottom: 10px;
  width: 200px;
  height: 140px;
  background-color: rgba(20, 20, 20, 0.85);
  border-width: 1px;
  border-color: #3a3a3a;
}

/* Blackboard (graph parameters): overlaid at the top-left of the graph */
#vne-blackboard {
  position: absolute;
  left: 10px;
  top: 10px;
  width: 240px;
  max-height: 70%;
}

.vne-blackboard__value {
  margin-left: 8px;
  margin-right: 4px;
}

.vne-blackboard__value > .unity-base-field__label {
  min-width: 50px;
  width: 50px;
}
