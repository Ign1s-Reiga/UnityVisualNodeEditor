/*
 * Attached to each NodeView itself (not the window root) so that it reliably overrides
 * GraphView's built-in Node.uss, which is also attached to the node.
 * Category colors come from the variables on .vne-root (NodeGraphEditor.uss).
 */

/* Category strip along the top edge of the title */

.vne-node #title {
  border-top-width: 3px;
  border-top-color: var(--vne-category-default);
}

.vne-node--flow #title {
  border-top-color: var(--vne-category-flow);
}

.vne-node--state #title {
  border-top-color: var(--vne-category-state);
}

.vne-node--event #title {
  border-top-color: var(--vne-category-event);
}

.vne-node--entity #title {
  border-top-color: var(--vne-category-entity);
}

.vne-node--system #title {
  border-top-color: var(--vne-category-system);
}

/* The Entry / Exit nodes inside a container */
.vne-node--container #title {
  border-top-color: var(--vne-category-container);
}

/* One-line summary directly below the title */

.vne-node__summary {
  max-width: 220px;
  padding: 2px 8px 4px 8px;
  font-size: 11px;
  color: #b4b4b4;
  background-color: #2b2b2b;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  -unity-text-align: middle-left;
}

/* NodeBehaviours attached to the node, below the ports (GraphView hides the extension area when collapsed) */

.vne-node__behaviours {
  max-width: 220px;
  padding: 3px 8px 4px 8px;
  font-size: 10px;
  color: #9ec7ff;
  background-color: #2b2b2b;
  border-top-width: 1px;
  border-top-color: #232323;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  -unity-text-align: middle-left;
}

/* Collapsed nodes (title ▼ button) also hide the summary line */

.vne-node--collapsed .vne-node__summary {
  display: none;
}

/* Nodes with at most one input and one output don't need "in" / "out" labels */

.vne-node--hide-port-labels Port #type {
  display: none;
}

/*
 * Event nodes read as transitions, not states: a short tag with rounded corners whose title is the event name.
 * Only the size and shape change; the colors still come from the category and the state classes below.
 */

.vne-node--transition #node-border,
.vne-node--transition #selection-border {
  border-radius: 11px;
}

.vne-node--transition #title {
  height: 22px;
  min-height: 22px;
}

.vne-node--transition #title-label {
  margin: 0 10px 0 10px;
  font-size: 11px;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
}

/* Nothing to collapse on a node with one input and one output */
.vne-node--transition #title-button-container {
  display: none;
}

.vne-node--transition #input,
.vne-node--transition #output {
  padding-top: 0;
  padding-bottom: 0;
}

.vne-node--transition Port {
  height: 18px;
}

/* Validation */

.vne-node--warning #node-border {
  border-color: #e0a030;
  border-width: 2px;
}

.vne-node--error #node-border {
  border-color: #e04040;
  border-width: 2px;
}

/* Node search: matches stand out, the rest fade (before Play Mode so the running node still wins) */

.vne-node--search-dimmed {
  opacity: 0.35;
}

.vne-node--search-match #node-border {
  border-color: #5aa9ff;
  border-width: 2px;
}

/* Play Mode: nodes the runner passed through recently (trail), fainter than the current node */

.vne-node--visited #node-border {
  border-color: rgba(74, 222, 128, 0.45);
  border-width: 2px;
}

/* Play Mode: the node the GraphRunner is currently on (after validation so it wins) */

.vne-node--running #node-border {
  border-color: #4ade80;
  border-width: 3px;
}

.vne-node--running #title {
  background-color: rgba(74, 222, 128, 0.25);
}
