.vne-root {
  flex-grow: 1;

  /* Category colors, shared by nodes (NodeView.uss) and the inspector header */
  --vne-category-default: #6e6e6e;
  --vne-category-flow: #4a90d9;
  --vne-category-state: #4caf6a;
  --vne-category-event: #b36ad9;
  --vne-category-entity: #2bb3a3;
  --vne-category-system: #d19a52;
  --vne-category-container: #d9668a;
}

.vne-inspector-view__icon.vne-category--flow {
  background-color: var(--vne-category-flow);
}

.vne-inspector-view__icon.vne-category--state {
  background-color: var(--vne-category-state);
}

.vne-inspector-view__icon.vne-category--event {
  background-color: var(--vne-category-event);
}

.vne-inspector-view__icon.vne-category--entity {
  background-color: var(--vne-category-entity);
}

.vne-inspector-view__icon.vne-category--system {
  background-color: var(--vne-category-system);
}

.vne-inspector-view__icon.vne-category--container {
  background-color: var(--vne-category-container);
}

/* Toolbar */

.vne-toolbar-spacer {
  flex-grow: 1;
}

/* One-click Play (PlaySetup): the shortest path from "I built a flow" to "it runs" */
.vne-play-button {
  -unity-font-style: bold;
  color: #7fd18b;
}

/* Long names are cut from the start so the distinctive end and the " *" mark stay visible */
.vne-asset-name {
  flex-shrink: 1;
  min-width: 40px;
  max-width: 50%;
  margin-left: 4px;
  margin-right: 6px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  -unity-text-overflow-position: start;
  -unity-text-align: middle-right;
}

.vne-asset-name:hover {
  color: #ffffff;
}

/* Container levels: breadcrumbs (Root > Stage > ...), shown only inside a container */

.vne-level-bar--hidden {
  display: none;
}

.vne-level-breadcrumbs {
  flex-shrink: 1;
  overflow: hidden;
}

/* Layout: TwoPaneSplitView (graph | inspector) */

.vne-main {
  flex-grow: 1;
}

.vne-graph-container {
  flex-grow: 1;
  min-width: 200px;
}

/* Inspector */

.vne-inspector {
  min-width: 220px;
  border-left-width: 1px;
  border-left-color: #191919;
  background-color: #282828;
}

.vne-inspector-view {
  padding: 6px;
}

.vne-inspector-view__header {
  margin-bottom: 8px;
  padding-bottom: 6px;
  border-bottom-width: 1px;
  border-bottom-color: #191919;
}

.vne-inspector-view__type-row {
  flex-direction: row;
  align-items: center;
  margin-left: 3px;
  margin-bottom: 2px;
}

.vne-inspector-view__icon {
  width: 10px;
  height: 10px;
  border-radius: 2px;
  margin-right: 5px;
  flex-shrink: 0;
  background-color: var(--vne-category-default);
}

.vne-inspector-view__type {
  font-size: 10px;
  color: #a0a0a0;
  -unity-text-align: middle-left;
}

.vne-inspector-view__title > .unity-base-text-field__input {
  font-size: 14px;
  -unity-font-style: bold;
  min-height: 22px;
}

.vne-inspector-view__empty {
  color: #888888;
  white-space: normal;
}

/* Fields: labels take a share of the panel width and inputs may shrink, so nothing overflows at 220px */

.vne-inspector-view .unity-base-field {
  flex-shrink: 1;
  min-width: 0;
}

.vne-inspector-view .unity-base-field__label {
  min-width: 0;
  width: 38%;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.vne-inspector-view .unity-base-field__input {
  min-width: 0;
  flex-shrink: 1;
}

.vne-inspector-view .unity-text-field__input--multiline {
  white-space: normal;
}

/* Container exits: the list in a container's inspector, the picker in an Exit node's inspector */

.vne-exit-list {
  margin-top: 8px;
  padding-top: 6px;
  border-top-width: 1px;
  border-top-color: #191919;
}

.vne-exit-list__header {
  margin-left: 3px;
  margin-bottom: 4px;
  -unity-font-style: bold;
}

.vne-exit-list__list {
  max-height: 240px;
}

.vne-exit-list__row {
  flex-direction: row;
  align-items: center;
  padding-right: 2px;
}

.vne-exit-list__name {
  flex-grow: 1;
  flex-shrink: 1;
  min-width: 0;
}

.vne-exit-list__remove {
  width: 20px;
  margin-left: 2px;
  margin-right: 0;
  flex-shrink: 0;
}

.vne-exit-list__add {
  align-self: flex-start;
  margin-top: 4px;
}

.vne-exit-list__message,
.vne-exit-picker__message {
  display: none;
  margin-left: 3px;
  margin-top: 2px;
  color: #e0a030;
  white-space: normal;
}

.vne-exit-list__message--visible,
.vne-exit-picker__message--visible {
  display: flex;
}

/* "Now running" panel above the inspector while playing (RuntimePanel) */

.vne-runtime-panel {
  margin: 6px 6px 0 6px;
  padding: 6px 8px 8px 8px;
  border-width: 1px;
  border-color: #2f6b45;
  border-radius: 4px;
  background-color: rgba(74, 222, 128, 0.08);
}

.vne-runtime-panel--hidden {
  display: none;
}

.vne-runtime-panel__header {
  font-size: 10px;
  color: #7fd18b;
  -unity-font-style: bold;
}

.vne-runtime-panel__location {
  font-size: 13px;
  -unity-font-style: bold;
  color: #e6e6e6;
  white-space: normal;
  margin-bottom: 4px;
}

.vne-runtime-panel__actions {
  flex-direction: row;
  flex-wrap: wrap;
}

.vne-runtime-panel__action {
  margin-left: 0;
  margin-right: 4px;
  margin-bottom: 2px;
}

.vne-runtime-panel__empty {
  color: #a0a0a0;
  white-space: normal;
}

.vne-runtime-panel__empty--hidden {
  display: none;
}

/* Event name field: text plus a button that picks a name already used in the graph */

/* Scene field: Pick… and Create Scene… while no scene is set */
.vne-scene-field__actions {
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 2px;
}

.vne-scene-field__actions Button {
  margin-left: 2px;
  margin-right: 0;
}

/* Small note under a node's fields (e.g. how a Scene node behaves when the flow comes back) */
.vne-inspector-view__note {
  margin: 4px 3px 2px 3px;
  font-size: 10px;
  color: #8a8a8a;
  white-space: normal;
}

.vne-event-name-field {
  flex-direction: row;
  align-items: center;
}

.vne-event-name-field__text {
  flex-grow: 1;
  flex-shrink: 1;
  min-width: 0;
}

.vne-event-name-field__pick {
  width: 20px;
  margin-left: 2px;
  flex-shrink: 0;
}

/* NodeBehaviours in the inspector of State / Scene nodes */

.vne-behaviour-list {
  margin-top: 8px;
  padding-top: 6px;
  border-top-width: 1px;
  border-top-color: #191919;
}

.vne-behaviour-list__header {
  margin-left: 3px;
  margin-bottom: 4px;
  -unity-font-style: bold;
}

.vne-behaviour-list__empty {
  margin-left: 3px;
  margin-bottom: 4px;
  color: #888888;
  white-space: normal;
}

.vne-behaviour-list__item {
  margin-bottom: 4px;
  padding: 2px 2px 4px 2px;
  border-width: 1px;
  border-color: #191919;
  border-radius: 3px;
  background-color: #2f2f2f;
}

.vne-behaviour-list__item-header {
  flex-direction: row;
  align-items: center;
}

.vne-behaviour-list__item-title {
  flex-grow: 1;
  flex-shrink: 1;
  min-width: 0;
  margin-left: 3px;
  -unity-font-style: bold;
  color: #9ec7ff;
  overflow: hidden;
  text-overflow: ellipsis;
}

.vne-behaviour-list__item-title--missing {
  color: #e0a030;
}

.vne-behaviour-list__button {
  flex-shrink: 0;
  min-width: 20px;
  margin-left: 1px;
  margin-right: 1px;
}

.vne-behaviour-list__footer {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 2px;
}

/* Node search */

.vne-node-search {
  width: 160px;
  min-width: 80px;
  flex-shrink: 1;
}

.vne-search-count {
  color: #a0a0a0;
  margin-right: 6px;
  -unity-text-align: middle-left;
  flex-shrink: 0;
}

/* Validation (node borders are in NodeView.uss) */

.vne-issue-toggle {
  flex-shrink: 0;
  min-width: 80px;
}

.vne-issue-toggle .unity-toggle__text {
  margin-left: 4px;
  margin-right: 4px;
}

.vne-issue-toggle.vne-issue--warning .unity-toggle__text {
  color: #e0a030;
}

.vne-issue-toggle.vne-issue--error .unity-toggle__text {
  color: #e04040;
}

.vne-issue-list {
  height: 100px;
  flex-shrink: 0;
  border-top-width: 1px;
  border-top-color: #191919;
  background-color: #282828;
}

.vne-issue-list--hidden {
  display: none;
}

/* The list is hidden whenever there are no issues, so never show "List is empty" */
.vne-issue-list .unity-list-view__empty-label {
  display: none;
}

/* One issue: the message, then a button that fixes it when there is a known fix */
.vne-issue-list__item {
  flex-direction: row;
  align-items: center;
  padding-left: 6px;
  padding-right: 4px;
}

.vne-issue-list__message {
  flex-grow: 1;
  flex-shrink: 1;
  min-width: 0;
  -unity-text-align: middle-left;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.vne-issue-list__fix {
  flex-shrink: 0;
  height: 16px;
  margin: 0 0 0 6px;
  padding: 0 6px 0 6px;
  font-size: 11px;
}

.vne-issue-list__fix--hidden {
  display: none;
}

.vne-issue-list__item:hover {
  background-color: #3a3a3a;
}

.vne-issue--warning {
  color: #e0a030;
}

.vne-issue--error {
  color: #e04040;
}
