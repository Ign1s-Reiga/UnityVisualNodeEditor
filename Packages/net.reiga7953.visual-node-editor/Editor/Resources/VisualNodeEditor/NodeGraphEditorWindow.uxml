<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
  <ui:VisualElement name="root" class="vne-root">
    <uie:Toolbar name="toolbar" class="vne-toolbar">
      <uie:ToolbarButton name="save-button" text="Save" />
      <uie:ToolbarSpacer />
      <uie:ToolbarButton name="frame-all-button" text="Frame All" tooltip="Show the whole graph (A)" />
      <uie:ToolbarButton name="frame-selection-button" text="Frame Selection" tooltip="Show the selection, or the whole graph if nothing is selected (F)" />
      <uie:ToolbarMenu name="view-menu" text="View" tooltip="MiniMap, Blackboard and Snap to Grid" />
      <uie:ToolbarSpacer />
      <uie:ToolbarButton name="build-settings-button" text="Add Scenes to Build" tooltip="Add the scenes used by this graph to Build Settings, or enable them there (existing order is kept)" />
      <ui:VisualElement class="vne-toolbar-spacer" />
      <uie:ToolbarSearchField name="node-search" class="vne-node-search" tooltip="Find nodes by title or type. Enter: next match, Esc: clear" />
      <ui:Label name="search-count" class="vne-search-count" />
      <uie:ToolbarToggle name="issue-toggle" class="vne-issue-toggle" tooltip="Show or hide the issue list" />
      <ui:Label name="asset-name" class="vne-asset-name" text="(no asset)" />
    </uie:Toolbar>
    <uie:Toolbar name="level-bar" class="vne-level-bar vne-level-bar--hidden" tooltip="The container level being edited. Click a parent to go back up">
      <uie:ToolbarBreadcrumbs name="level-breadcrumbs" class="vne-level-breadcrumbs" />
    </uie:Toolbar>
    <ui:TwoPaneSplitView name="main" class="vne-main" orientation="Horizontal" fixed-pane-index="1" fixed-pane-initial-dimension="300" view-data-key="vne-main-split">
      <ui:VisualElement name="graph-container" class="vne-graph-container" />
      <ui:ScrollView name="inspector" class="vne-inspector" />
    </ui:TwoPaneSplitView>
    <ui:ListView name="issue-list" class="vne-issue-list vne-issue-list--hidden" fixed-item-height="20" selection-type="None" />
  </ui:VisualElement>
</ui:UXML>
