{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(ls*)",
      "Bash(find*)",
      "Bash(cat*)"
    ],
    "deny": [
      "Bash(python*)",
      "Bash(pip*)",
      "Read(./Library/**)",
      "Read(./Temp/**)",
      "Read(./Logs/**)",
      "Edit(./Library/**)",
      "Edit(**/*.meta)"
    ]
  }
}
